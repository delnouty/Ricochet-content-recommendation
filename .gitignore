# Données brutes et volumineuses (à télécharger, jamais versionnées)
data/raw/
data/*.csv
data/*.pickle
data/*.pkl
data/*.npy
data/*.zip
dta/news-portal-user

# Artefacts de modèle générés (peuvent être régénérés / poussés vers Blob)
# `models/*` et non `models/` : à l'intérieur d'un dossier ignoré, les exceptions
# ci-dessous seraient sans effet.
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Azure Functions
azure_function/local.settings.json
azure_function/.python_packages/
azure_function/bin/
azure_function/obj/

# Base des clients inscrits localement (données d'usage, jamais versionnées)
local/clients.db
*.db

# Secrets / config locale
.env
*.env

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Downloaded dataset (actual folder used by the notebook)
data/news-portal-user/
*.zip

# Claude Code local settings
.claude/settings.local.json

# Traçabilité MLflow (local, régénérable)
mlflow.db
mlruns/
models_split/
models_split_svd*/
metrics.json

# Exception : la référence de métriques est le contrat de la porte de qualité,
# elle DOIT être versionnée (sinon la CI n'a rien à comparer).
!models/baseline_metrics.json

# Fichiers intermédiaires LaTeX (le .tex est la source, le .pdf est versionné)
docs/*.aux
docs/*.log
docs/*.nav
docs/*.out
docs/*.snm
docs/*.toc
