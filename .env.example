# Configuration locale — copier en `.env` et compléter.
#
#     cp .env.example .env
#     . ./scripts/charger_env.ps1
#
# `.env` est dans `.gitignore` et ne doit jamais être versionné : il porte des
# secrets. `check_secrets.py` reconnaît le format sans guillemets, donc un `.env`
# indexé par erreur serait refusé au push — mais ne comptez pas sur le filet.
#
# Toutes ces variables sont **optionnelles** : chaque programme a un défaut
# raisonnable. Ce fichier sert à ne pas les retaper à chaque terminal.

# ── Solution Azure ───────────────────────────────────────────────────────────
# Lues par app/app_full.py, app/streamlit_app.py et scripts/smoke_azure.py.
FUNCTION_URL=https://func-ricochet-darya.azurewebsites.net/api/recommend
FUNCTION_KEY=<votre-cle-de-fonction>

# Clients inscrits dans Azure Table Storage au lieu de SQLite. Sans cette
# variable, l'application retombe sur SQLite en le disant.
AZURE_STORAGE_CONNECTION_STRING=<votre-chaine-de-connexion>

# ── Solution Hugging Face ────────────────────────────────────────────────────
# Dépôt de modèle d'où le Space télécharge les artefacts. `MODELS_DIR` (plus bas)
# court-circuite ce téléchargement pour un test local.
HF_MODEL_REPO=DaryaEL/ricochet-models
# Nécessaire seulement pour publier, ou si le dépôt de modèle est privé.
HF_TOKEN=<votre-jeton-hugging-face>

# ── Chemins locaux ───────────────────────────────────────────────────────────
# Dossier des artefacts. Défaut : ./models puis ../models.
MODELS_DIR=models
# Données brutes, pour l'affichage enrichi (articles_metadata.csv).
DATA_DIR=data/news-portal-user
# Base des clients inscrits. Défaut : local/clients.db côté solution locale.
CLIENTS_DB=local/clients.db

# ── Réglages ─────────────────────────────────────────────────────────────────
# `sqlite` force le stockage local même si une chaîne de connexion Azure est
# présente — utile pour essayer l'interface sans écrire dans le cloud.
RICOCHET_STORE=
# Suivi MLflow. Défaut : sqlite:///mlflow.db à la racine du dépôt.
MLFLOW_TRACKING_URI=
